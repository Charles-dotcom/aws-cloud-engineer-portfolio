aws_region  = "af-south-1"
project     = "portfolio"
environment = "staging"
owner       = "charles-mphahlele"
cost_center = "portfolio"

vpc_cidr             = "10.20.0.0/16"
availability_zones   = ["af-south-1a", "af-south-1b"]
public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

single_nat_gateway     = true
enable_flow_logs       = true
enable_alb_access_logs = true
use_spot               = true
task_cpu               = 512
task_memory            = 1024
desired_count          = 2
instance_class         = "db.t3.small"

container_image = "ACCOUNT_ID.dkr.ecr.af-south-1.amazonaws.com/portfolio-staging:1.0.0"
permissions_boundary_arn = "arn:aws:iam::ACCOUNT_ID:policy/portfolio-workload-boundary"
db_name         = "app"
db_username     = "app"
