# Copy to backend.s3.tf only after the first local apply has created the
# bucket, table and key. Then run: terraform init -migrate-state
# backend.s3.tf is gitignored.

terraform {
  backend "s3" {
    bucket         = "portfolio-tfstate-ACCOUNT_ID"
    key            = "bootstrap/terraform.tfstate"
    region         = "af-south-1"
    dynamodb_table = "portfolio-terraform-locks"
    encrypt        = true
    kms_key_id     = "arn:aws:kms:af-south-1:ACCOUNT_ID:key/KEY_ID"
  }
}
