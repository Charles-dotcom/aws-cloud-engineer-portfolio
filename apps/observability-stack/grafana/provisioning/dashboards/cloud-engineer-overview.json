{
  "dashboard": {
    "title": "Cloud Engineer Portfolio - Observability",
    "uid": "cloud-engineer-observability",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "title": "Prometheus Up",
        "type": "stat",
        "targets": [
          { "expr": "up", "legendFormat": "{{job}}" }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
      },
      {
        "title": "Scrape Duration",
        "type": "graph",
        "targets": [
          { "expr": "scrape_duration_seconds", "legendFormat": "{{job}}" }
        ],
        "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 }
      }
    ]
  },
  "overwrite": true
}